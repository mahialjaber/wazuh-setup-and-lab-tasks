<!--
  Minimal LAB Sysmon configuration (NOT the full SwiftOnSecurity / Sysmon-Modular ruleset).
  Logs only network connections to ports 445, 3389 and 22 plus LSASS access; it does not see HTTP/HTTPS
  C2. For real coverage start from SwiftOnSecurity/sysmon-config or olafhartong/sysmon-modular.
  Target: Windows 11 Enterprise (windows-vm-01)
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
  <EventFiltering>
    <!-- Event ID 1: Process Creation -->
    <RuleGroup name="ProcessCreation" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <!-- Exclude benign noisy background binaries -->
      </ProcessCreate>
    </RuleGroup>

    <!-- Event ID 3: Network Connection -->
    <RuleGroup name="NetworkConnection" groupRelation="or">
      <NetworkConnect onmatch="include">
        <DestinationPort condition="is">445</DestinationPort>
        <DestinationPort condition="is">3389</DestinationPort>
        <DestinationPort condition="is">22</DestinationPort>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event ID 10: ProcessAccess (LSASS Memory Access) -->
    <RuleGroup name="ProcessAccess" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
